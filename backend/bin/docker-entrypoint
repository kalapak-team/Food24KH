#!/bin/bash -e

# Thruster reads HTTP_PORT (default 80). Railway / most PaaS inject PORT instead.
if [ -n "${PORT:-}" ] && [ -z "${HTTP_PORT:-}" ]; then
  export HTTP_PORT="${PORT}"
fi

# If running the rails server (directly or via Thruster), create/migrate the database.
if [ "${1}" == "./bin/thrust" ] || { [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; }; then
  echo "docker-entrypoint: preparing databases..."
  ./bin/rails db:prepare

  # Shared DATABASE_URL (Neon): secondary Solid schemas are not created by primary
  # prepare alone — migrate each connection explicitly.
  ./bin/rails db:migrate:cache
  ./bin/rails db:migrate:queue
  ./bin/rails db:migrate:cable
  echo "docker-entrypoint: databases ready"
fi

exec "${@}"
