# Food24KH — root gitignore

# Dependencies
node_modules/
.pnp
.pnp.js
**/vendor/bundle/

# Environment / secrets
.env
.env.local
.env.*.local
!.env.example
backend/.env
backend/config/master.key
backend/config/credentials/*.key
backend/.kamal/secrets

# Build / Next.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Rails
backend/log/*
backend/tmp/*
!backend/log/.keep
!backend/tmp/.keep
backend/storage/*
!backend/storage/.keep
backend/public/assets
backend/.byebug_history
backend/tmp/pids/*
!backend/tmp/pids/.keep

# Logs / debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Testing / coverage
coverage/
.nyc_output/

# Misc
*.pem
.vercel
